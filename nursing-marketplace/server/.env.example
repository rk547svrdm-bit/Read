DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=4000

# Durata di default (in ore) di un'asta quando un listing viene pubblicato
AUCTION_DEFAULT_DURATION_HOURS=48

# Rilancio minimo di default (in valuta) tra un'offerta e la successiva
AUCTION_DEFAULT_MIN_INCREMENT=1

# Ogni quanti secondi il worker in-process controlla le aste scadute
AUCTION_CLOSER_INTERVAL_SECONDS=30
