// Nursing Marketplace — schema dati
//
// Nota: il provider di default è SQLite per rendere lo scaffold eseguibile
// da subito senza dipendenze esterne. Per passare a PostgreSQL in
// produzione basta cambiare `provider` in "postgresql" e valorizzare
// DATABASE_URL di conseguenza: i tipi usati qui sono già compatibili.
//
// Campi enum-like (ruoli, turni, ambienti di cura, stati...) sono
// modellati come String validati a livello applicativo (vedi
// src/constants.ts) invece che come `enum` Prisma, perché SQLite non
// supporta enum nativi.
//
// Liste (competenze, specializzazioni, turni preferiti, ambienti
// accettati...) sono salvate come stringa JSON e (de)serializzate nel
// service layer (vedi src/utils/json.ts), per la stessa ragione.
//
// L'asta riguarda sempre ed esclusivamente il professionista (NurseProfile),
// non una specifica data/turno: può essere "oraria" (sulla tariffa/h) oppure
// "a prestazione" (su una voce del suo catalogo NurseService), a scelta del
// professionista che la apre.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  role          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  nurseProfile    NurseProfile?
  clientProfile   ClientProfile?
  bids            Bid[]
  reviewsWritten  Review[] @relation("ReviewAuthor")
  reviewsReceived Review[] @relation("ReviewTarget")
}

model NurseProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName            String
  headline            String?
  bio                 String
  photoUrl            String?
  licenseNumber       String?
  yearsExperience     Int      @default(0)

  skillsJson          String   @default("[]")
  specializationsJson String   @default("[]")
  certificationsJson  String   @default("[]")

  city                String
  travelRadiusKm      Int      @default(10)

  // Preferenze generali mostrate sul profilo (informative, filtrabili in
  // directory); non condizionano più la creazione di una singola asta.
  minHourlyRate       Float
  acceptsHolidays     Boolean  @default(false)
  acceptsWeekends     Boolean  @default(false)
  acceptsNights       Boolean  @default(false)
  preferredShiftsJson String   @default("[]") // sottoinsieme di ShiftType
  careSettingsJson    String   @default("[]") // sottoinsieme di CareSetting

  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  services            NurseService[]
  auctions            Auction[]

  @@index([city])
}

model ClientProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName  String
  organization String?
  city         String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Catalogo delle prestazioni offerte dal professionista, a sua discrezione
// (es. Iniezione, Prelievo, ECG, Intramuscolo, ma anche voci custom come
// Impianto PICC o assistenza a intervento chirurgico), ciascuna con la
// propria paga minima.
model NurseService {
  id          String   @id @default(cuid())
  nurseId     String
  nurse       NurseProfile @relation(fields: [nurseId], references: [id], onDelete: Cascade)

  name        String
  description String?
  minPrice    Float
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  auctions    Auction[]

  @@index([nurseId])
}

model Auction {
  id                  String   @id @default(cuid())
  nurseId             String
  nurse               NurseProfile  @relation(fields: [nurseId], references: [id], onDelete: Cascade)

  type                String   // HOURLY | SERVICE — vedi AUCTION_TYPES
  serviceId           String?
  service             NurseService? @relation(fields: [serviceId], references: [id])

  startAt             DateTime
  endAt               DateTime
  minIncrement        Float    @default(1)
  startingPrice       Float
  currentPrice        Float
  currentHighestBidId String?

  status              String   @default("OPEN") // vedi AUCTION_STATUS

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  bids                Bid[]
  booking             Booking?

  @@index([status, endAt])
  @@index([nurseId])
}

model Bid {
  id        String   @id @default(cuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  clientId  String
  client    User     @relation(fields: [clientId], references: [id])

  amount    Float
  status    String   @default("ACTIVE") // vedi BID_STATUS

  createdAt DateTime @default(now())

  @@index([auctionId])
}

model Booking {
  id         String   @id @default(cuid())
  auctionId  String   @unique
  auction    Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  nurseId    String
  clientId   String
  finalPrice Float
  status     String   @default("CONFIRMED") // vedi BOOKING_STATUS

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  reviews    Review[]
}

model Review {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  authorId  String
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetId  String
  target    User     @relation("ReviewTarget", fields: [targetId], references: [id])

  rating    Int
  comment   String?

  createdAt DateTime @default(now())

  @@index([targetId])
}
