// Nursing Marketplace — schema dati
//
// Nota: il provider di default è SQLite per rendere lo scaffold eseguibile
// da subito senza dipendenze esterne. Per passare a PostgreSQL in
// produzione basta cambiare `provider` in "postgresql" e valorizzare
// DATABASE_URL di conseguenza: i tipi usati qui sono già compatibili.
//
// Campi enum-like (ruoli, turni, ambienti di cura, stati...) sono
// modellati come String validati a livello applicativo (vedi
// src/constants.ts) invece che come `enum` Prisma, perché SQLite non
// supporta enum nativi.
//
// Liste (competenze, specializzazioni, turni preferiti, ambienti
// accettati...) sono salvate come stringa JSON e (de)serializzate nel
// service layer (vedi src/utils/json.ts), per la stessa ragione.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  role          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  nurseProfile    NurseProfile?
  clientProfile   ClientProfile?
  bids            Bid[]
  reviewsWritten  Review[] @relation("ReviewAuthor")
  reviewsReceived Review[] @relation("ReviewTarget")
}

model NurseProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName            String
  headline            String?
  bio                 String
  licenseNumber       String?
  yearsExperience     Int      @default(0)

  skillsJson          String   @default("[]")
  specializationsJson String   @default("[]")
  certificationsJson  String   @default("[]")

  city                String
  travelRadiusKm      Int      @default(10)

  // Requisiti richiesti per prendere in considerazione un'offerta di lavoro
  minHourlyRate       Float
  acceptsHolidays     Boolean  @default(false)
  acceptsWeekends     Boolean  @default(false)
  acceptsNights       Boolean  @default(false)
  preferredShiftsJson String   @default("[]") // sottoinsieme di ShiftType
  careSettingsJson    String   @default("[]") // sottoinsieme di CareSetting

  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  listings            Listing[]

  @@index([city])
}

model ClientProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName  String
  organization String?
  city         String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Listing {
  id            String   @id @default(cuid())
  nurseId       String
  nurse         NurseProfile @relation(fields: [nurseId], references: [id], onDelete: Cascade)

  title         String
  description   String

  careSetting   String   // vedi CARE_SETTINGS
  shiftType     String   // vedi SHIFT_TYPES
  isHoliday     Boolean  @default(false)
  isWeekend     Boolean  @default(false)

  serviceDate   DateTime
  durationHours Float
  city          String

  startingPrice Float
  status        String   @default("DRAFT") // vedi LISTING_STATUS

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  auction       Auction?

  @@index([city, status])
}

model Auction {
  id                  String   @id @default(cuid())
  listingId           String   @unique
  listing             Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  startAt             DateTime
  endAt               DateTime
  minIncrement        Float    @default(1)
  startingPrice       Float
  currentPrice        Float
  currentHighestBidId String?

  status              String   @default("SCHEDULED") // vedi AUCTION_STATUS

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  bids                Bid[]
  booking             Booking?

  @@index([status, endAt])
}

model Bid {
  id        String   @id @default(cuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  clientId  String
  client    User     @relation(fields: [clientId], references: [id])

  amount    Float
  status    String   @default("ACTIVE") // vedi BID_STATUS

  createdAt DateTime @default(now())

  @@index([auctionId])
}

model Booking {
  id         String   @id @default(cuid())
  auctionId  String   @unique
  auction    Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  nurseId    String
  clientId   String
  finalPrice Float
  status     String   @default("CONFIRMED") // vedi BOOKING_STATUS

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  reviews    Review[]
}

model Review {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  authorId  String
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetId  String
  target    User     @relation("ReviewTarget", fields: [targetId], references: [id])

  rating    Int
  comment   String?

  createdAt DateTime @default(now())

  @@index([targetId])
}
